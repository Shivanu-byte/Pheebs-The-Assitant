APP_NAME=Pheebs
APP_ENV=development
DEBUG=true

# NVIDIA LLM
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_nvidia_api_key_here
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# NVIDIA STT
NVIDIA_STT_URL=https://1598d209-5e27-4d3c-8079-4751568b1081.invocation.api.nvcf.nvidia.com/v1/audio/transcriptions
STT_MODEL=nvidia/parakeet-1.1b-rnnt-multilingual-asr

# TTS
TTS_MODEL=chatterbox
TTS_VOICE_PATH=

AUDIO_SAMPLE_RATE=24000
PYTHONPATH=.
